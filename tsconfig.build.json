{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // allowImportingTsExtensions is only legal with noEmit or emitDeclarationOnly.
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__test__/**"]
}