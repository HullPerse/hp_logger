{
  "compilerOptions": {
    // Environment and runtime: Bun 1.4+ first-class, Node compatible.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types"],
    "noEmit": true,

    // Kept for CommonJS consumers of the library (export = interop).
    "esModuleInterop": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // Stricter flags, disabled by design: unused code is tracked by knip/oxlint.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Path alias (the only place @/* is declared)
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}