{
  "name": "hp_logger",
  "version": "0.7.0",
  "description": "Structured logger for Bun/Node with levels, redaction, colors, file output and server framework integrations",
  "type": "module",
  "main": "./dist/index.logger.js",
  "types": "./dist/index.logger.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.logger.d.ts",
      "import": "./dist/index.logger.js"
    },
    "./elysia": {
      "types": "./dist/plugins/elysia.plugin.d.ts",
      "import": "./dist/plugins/elysia.plugin.js"
    },
    "./bun": {
      "types": "./dist/plugins/bun.server.d.ts",
      "import": "./dist/plugins/bun.server.js"
    },
    "./node": {
      "types": "./dist/plugins/node.server.d.ts",
      "import": "./dist/plugins/node.server.js"
    },
    "./hono": {
      "types": "./dist/plugins/hono.plugin.d.ts",
      "import": "./dist/plugins/hono.plugin.js"
    },
    "./fastify": {
      "types": "./dist/plugins/fastify.plugin.d.ts",
      "import": "./dist/plugins/fastify.plugin.js"
    },
    "./http": {
      "types": "./dist/http/log.server.d.ts",
      "import": "./dist/http/log.server.js"
    },
    "./test": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./worker": {
      "types": "./dist/worker/thread.transport.d.ts",
      "import": "./dist/worker/thread.transport.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "logger",
    "logging",
    "bun",
    "elysia",
    "hono",
    "fastify",
    "structured"
  ],
  "license": "MIT",
  "author": "HullPerse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HullPerse/hp_logger.git"
  },
  "peerDependencies": {
    "elysia": ">=1.0.0",
    "fastify": ">=4.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "bun-types": "^1.4.0",
    "elysia": "^1.4.29",
    "fastify": "^5.12.1",
    "hono": "^4.13.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  }
}
